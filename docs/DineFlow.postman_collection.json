            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_ids\": [\n    11,\n    12\n  ],\n  \"date_time\": \"{{reserveAt}}\",\n  \"guest_count\": 8,\n  \"note\": \"Sinh nhật\",\n  \"pre_order_items\": [\n    {\n      \"food_id\": 9,\n      \"quantity\": 2,\n      \"note\": \"Không hành\"\n    }\n  ],\n  \"pre_order_payment\": \"cash\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('reserveAt', new Date(Date.now() + 3 * 24 * 3600 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.id) { pm.collectionVariables.set('reservationId', j.data.id); }",
